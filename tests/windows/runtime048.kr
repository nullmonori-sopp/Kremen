package main
func square(value i64) i64 {
	return value * value
}
func exercise()!i64 {
	var made = fsMkdir("native-π-🌍")?
	assert(made)
	var written = fsWrite("native-π-🌍/from-π.bin", "a\r\nb\n\0\x1az")?
	assert(written)
	written = fsWrite("native-π-🌍/to-🌍.bin", "old")?
	assert(written)
	var renamed = fsRename("native-π-🌍/from-π.bin", "native-π-🌍/to-🌍.bin")?
	assert(renamed)
	var bytes = fsRead("native-π-🌍/to-🌍.bin")?
	assert(bytes == "a\r\nb\n\0\x1az")
	var handle = fsOpen("native-π-🌍/open-🌍.bin", "w")?
	var count = fsWriteAll(handle, "a\r\nb\0c")?
	assert(count == 6)
	var closed = fsClose(handle)?
	assert(closed)
	var reopened = fsOpen("native-π-🌍/open-🌍.bin", "r")?
	var read = fsReadAll(reopened)?
	assert(read == "a\r\nb\0c")
	closed = fsClose(reopened)?
	assert(closed)
	var listed = fsList("native-π-🌍")?
	unsafe {
		defer free(listed)
		assert(len(listed) == 2)
		assert(listed[0] == "open-🌍.bin")
		assert(listed[1] == "to-🌍.bin")
	}
	var removed = fsRemove("native-π-🌍/open-🌍.bin")?
	assert(removed)
	removed = fsRemove("native-π-🌍/to-🌍.bin")?
	assert(removed)
	removed = fsRemove("native-π-🌍")?
	assert(removed)
	var job = threadSpawn(square, 9)?
	defer threadClose(job)
	return threadJoin(job)
}
func main() {
	match exercise() {
		ok(value) => {
			assert(value == 81)
			println("native runtime 048 ok")
		}
		fail(code) => {
			println("runtime failed:", code)
			assert(false)
		}
	}
}
