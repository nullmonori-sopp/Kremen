package main

func main() {
    unsafe {
        var values = alloc[i64](4)
        println(len(values), values[0], values[3])
        values[1] = 7
        values[2] = 11
        var middle = slice(values, 1, 3)
        middle[0] = 19
        println(len(middle), middle[0], middle[1], values[1])
        var empty = slice(values, 2, 2)
        println(len(empty))
        free(values)
    }
}
