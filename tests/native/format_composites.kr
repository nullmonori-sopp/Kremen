// Composite-literal braces must stay distinct from statement blocks.
package main
type Point struct{x i64;y i64}
func checked(value i64)!i64{if value<0{return fail(8)};return ok(value)}
func main(){
var points=[2]Point{Point{x:1,y:2},/* retain element comment */Point{x:3,y:4}}
var matrix=[2][2]i64{[2]i64{1,2},[2]i64{3,4}}
var result=checked(points[1].x)
if (Point{x:result.value,y:2}).x==3{println(points[0].y,matrix[1][0])}else{println(0)}
println(result.ok) // retain result comment
}
