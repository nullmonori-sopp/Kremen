package main
type Counter struct {
	value i64
}
func (c &mut Counter) add(delta i64) {
	c.value += delta
}
func (c Counter) current() i64 {
	return c.value
}
func sum(values[4]i64) i64 {
	var total i64 = 0
	for i := 0; i < len(values); i++ {
		total += values[i]
	}
	return total
}
func main() {
	var counter Counter = Counter{value: 0}
	var values [4]i64 =[4]i64{2, 3, 5, 7}
	for i := 0; i < len(values); i++ {
		if values[i] == 5 {
			continue
		}
		counter.add(values[i])
	}
	println("Array sum:", sum(values))
	println("Counter without five:", counter.current())
	if counter.current() == 12 {
		println("Check passed")
	} else {
		panic("unexpected counter value")
	}
}
